{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "ignoreDeprecations": "6.0",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./lib-cjs"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "lib", "lib-cjs", "node_modules"]
}
